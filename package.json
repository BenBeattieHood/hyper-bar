{
  "name": "hyper-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "extensions/hyper",
    "apps/site",
    "packages/ui"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root && npm run prepare:hyper",
    "build": "npm run build -w extensions/hyper && npm run build -w apps/site",
    "build:hyper": "npm run build -w extensions/hyper",
    "build:site": "npm run build -w apps/site",
    "check": "npm run check -w extensions/hyper",
    "dev:hyper": "npm run dev -w extensions/hyper",
    "dev:site": "npm run dev -w apps/site",
    "prepare:hyper": "npm run prepare:wxt -w extensions/hyper"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  }
}
