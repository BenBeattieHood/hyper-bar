{
  "name": "hyper-sidebar",
  "description": "An Arc-inspired spatial sidebar for browser bookmarks and tabs.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./demo": "./demo.ts",
    "./demo.css": "./entrypoints/sidepanel/style.css"
  },
  "scripts": {
    "dev": "wxt --port 3006",
    "dev:firefox": "wxt -b firefox --port 3006",
    "build": "wxt build",
    "build:e2e": "HYPER_E2E_BUILD=1 wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "clean": "wxt clean",
    "compile": "tsc --noEmit",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:quiet": "npm run build:e2e --silent && playwright test --reporter=line",
    "test": "vitest run --pool=threads",
    "test:quiet": "vitest run --pool=threads --reporter=dot --silent=passed-only",
    "bench:search": "vitest bench --run tests/bench/search.bench.ts",
    "check": "npm run compile --silent && npm run test:quiet --silent",
    "verify": "npm run compile && npm test && npm run build && npm run build:firefox",
    "index": "node scripts/generateIndex.ts",
    "prepare:wxt": "wxt prepare"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@hyper/ui": "file:../../packages/ui",
    "flexsearch": "^0.8.212",
    "jotai": "^2.20.3",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vite": "^7.2.2",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
